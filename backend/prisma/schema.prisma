generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  open
  in_process
  closed

  @@map("task_status")
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus @default(open)
  location    Unsupported("geometry(Point, 4326)")?

  @@map("tasks")
}